<?xml version="1.0" encoding="utf-8"?>
<!-- Left, the state in words; a tap there opens the app. Right, the switch, and under it
     the dimming, which a tap moves one step. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">
    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:textSize="22sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-light"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        android:gravity="end">
        <!-- each frame is a 1 dp wrapper painted in the text colour: a hairline in any palette -->
        <FrameLayout
            android:id="@+id/widget_switch_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="1dp">
            <TextView
                android:id="@+id/widget_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="62dp"
                android:includeFontPadding="false"
                android:gravity="center"
                android:fontFamily="sans-serif-light"
                android:textSize="22sp"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="5dp"
                android:paddingBottom="7dp" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/widget_dim_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="1dp">
            <TextView
                android:id="@+id/widget_dim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="62dp"
                android:includeFontPadding="false"
                android:gravity="center"
                android:fontFamily="sans-serif-light"
                android:textSize="15sp"
                android:maxLines="1"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:paddingTop="5dp"
                android:paddingBottom="6dp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
